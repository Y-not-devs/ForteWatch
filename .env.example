# Copy to .env; do not commit .env or secrets.
APP_NAME="ForteWatch"
ENVIRONMENT=dev
API_PORT=8000
WEB_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local SQLite database
DATABASE_URL=sqlite:///./data/app.db

# Optional application modules
ENABLE_AUTH=false
ENABLE_UPLOADS=true

# Local video storage
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=512

# Only needed if authentication is enabled. Replace before production use.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Optional API override; normally the frontend uses the local Vite proxy.
# VITE_API_URL=http://localhost:8000/api

# Generate a private key with: python scripts/init_analysis.py
ANALYSIS_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434
ANALYSIS_MODEL=qwen3.5:4b
ANALYSIS_TIMEOUT_SECONDS=280
